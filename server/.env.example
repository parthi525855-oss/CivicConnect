# CivicConnect Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection (SRV format — requires DNS SRV support)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.271di5h.mongodb.net/civicconnect?retryWrites=true&w=majority&appName=Cluster0

# Direct (non-SRV) connection — required if your DNS resolver refuses SRV queries
# (symptom: "querySrv ECONNREFUSED" in Node.js logs, even though Atlas is reachable)
# Replace <username> and <password> with your Atlas credentials.
# The replicaSet name for this cluster is: atlas-78m767-shard-0
MONGO_URI_DIRECT=mongodb://<username>:<password>@ac-chwhtvm-shard-00-00.271di5h.mongodb.net:27017,ac-chwhtvm-shard-00-01.271di5h.mongodb.net:27017,ac-chwhtvm-shard-00-02.271di5h.mongodb.net:27017/civicconnect?tls=true&replicaSet=atlas-78m767-shard-0&authSource=admin&retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_NAME=Municipal Administrator
ADMIN_EMAIL=admin@civicconnect.gov
ADMIN_PASSWORD=change_this_admin_password_123
